# Wzór konfiguracji. Skopiuj do `.env.local` i uzupełnij wartościami.
# Plik `.env.local` NIGDY nie trafia do repozytorium — patrz .gitignore.
#
# Lista jest kompletna: zawiera KAŻDĄ zmienną, po którą sięga kod aplikacji.
# Oznaczenia:
#   [WYMAGANE]  — bez tego dana funkcja nie działa
#   [opcjonalne] — kod ma sensowną wartość domyślną, podaną w komentarzu

# ── Baza i cache ────────────────────────────────────────────────────────────────
# [WYMAGANE] Produkcyjnie osobna baza niż deweloperska — nie ten sam klaster i nazwa.
DATABASE_URL=mongodb+srv://uzytkownik:haslo@klaster.mongodb.net/czat-sportowy
# [WYMAGANE] Redis trzyma liczniki limitów i strumienie analiz. Bez niego limity
# przechodzą w tryb awaryjny (patrz lib/billing/entitlements.js).
REDIS_URL=redis://127.0.0.1:6379

# ── Sesje ───────────────────────────────────────────────────────────────────────
# [WYMAGANE] Dwa RÓŻNE, długie i losowe sekrety. Ten sam w obu polach znosi sens ich
# rozdzielenia. Generowanie: `openssl rand -base64 48`
JWT_SECRET=
REFRESH_TOKEN_SECRET=
# [opcjonalne] Ważność linku resetu hasła w godzinach. Domyślnie 2.
RESET_TOKEN_TTL_HOURS=2

# ── Adresy ──────────────────────────────────────────────────────────────────────
# [WYMAGANE] Publiczny adres serwisu. Trafia do linków w mailach (weryfikacja konta,
# reset hasła), do metadanych SEO i do mapy witryny. Bez ukośnika na końcu.
APP_URL=https://czatsportowy.pl
# [WYMAGANE] Adres serwera socketów widziany przez przeglądarkę. Zaczyna się od
# NEXT_PUBLIC_, więc JEST wkompilowany w kod strony — nie wpisuj tu niczego tajnego.
# Produkcyjnie ten sam host co APP_URL, przez HTTPS/WSS.
NEXT_PUBLIC_SOCKET_URL=https://czatsportowy.pl
# [opcjonalne] Wywołania serwera do samego siebie (socket → trasa AI, harmonogram
# rozliczania typów). Domyślnie http://127.0.0.1:3001 — zostaw na pętli zwrotnej.
INTERNAL_API_URL=http://127.0.0.1:3001
NEXT_INTERNAL_URL=http://127.0.0.1:3001
# [WYMAGANE] Wspólny sekret dla wywołań wewnętrznych i zadania rozliczającego typy.
# Bez niego harmonogram rozliczania NIE wystartuje, a odpowiedzi asystenta w czacie
# nie będą się generowały. `openssl rand -hex 32`
INTERNAL_API_SECRET=

# ── Dane sportowe ───────────────────────────────────────────────────────────────
# [WYMAGANE] `apisports` = klucz bezpośrednio od API-Sports; `rapidapi` = przez RapidAPI.
# Domyślnie `rapidapi` — jeśli masz plan bezpośrednio u API-Sports, ustaw `apisports`.
FOOTBALL_PROVIDER=apisports
# [WYMAGANE] Klucz SERWEROWY — nigdy nie opuszcza backendu.
# Kod bierze klucz w kolejności: FOOTBALL_API_KEY → (RAPIDAPI_KEY albo API_SPORTS_KEY
# zależnie od FOOTBALL_PROVIDER). Wystarczy wypełnić jedno pole zgodne z dostawcą.
FOOTBALL_API_KEY=
API_SPORTS_KEY=
RAPIDAPI_KEY=
# [opcjonalne] Nadpisanie adresu i hosta API. Puste = wartości dostawcy z lib/football/client.js.
FOOTBALL_API_BASE=
FOOTBALL_API_HOST=

# [WYMAGANE do widgetów] Klucz do widgetów osadzanych w przeglądarce.
#
# UWAGA: ten klucz JEST WIDOCZNY w źródle strony — tak działają widgety API-Sports i nie da
# się tego obejść. Dostawca nie wydaje osobnych kluczy publicznych, więc:
#   1) w panelu API-Sports OGRANICZ ten klucz do swojej domeny oraz adresu IP serwera,
#   2) dopiero wtedy wpisz go tutaj.
# Bez tej zmiennej widgety się nie wyrenderują — i tak ma być. Nigdy nie wpisuj tu klucza,
# którego backend używa do zwykłych zapytań, dopóki nie jest ograniczony w panelu.
API_SPORTS_WIDGET_KEY=

# ── Modele językowe ─────────────────────────────────────────────────────────────
# [opcjonalne] Dostawca główny i zapasowy. Domyślnie `anthropic` z zapasem `openai`.
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=anthropic
# [WYMAGANE] Klucz dostawcy wskazanego w AI_PROVIDER. Klucz drugiego dostawcy jest
# potrzebny tylko wtedy, gdy zapas ma faktycznie działać — bez niego przy awarii
# głównego dostawcy analiza po prostu się nie wygeneruje.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# [opcjonalne] Modele. Puste = wartości domyślne z lib/ai/config.js.
# Model „szybki" obsługuje analizy meczów na żywo — jest wielokrotnie tańszy od głównego,
# a przy meczu w toku liczy się czas odpowiedzi, nie głębia wywodu.
AI_MODEL_OPENAI=gpt-5.5
AI_MODEL_OPENAI_FAST=gpt-4o
AI_MODEL_ANALYSIS=claude-opus-5
AI_MODEL_ANALYSIS_FAST=claude-sonnet-5
AI_MODEL_CHAT=claude-opus-5
# [opcjonalne] Głębokość rozumowania (`low` / `medium` / `high`). Puste = domyślne API.
AI_EFFORT=
# [opcjonalne] Górny limit odpowiedzi. Domyślnie 16000 i 2000.
AI_MAX_TOKENS_ANALYSIS=16000
AI_MAX_TOKENS_CHAT=2000
# [opcjonalne] Bezpiecznik: po przekroczeniu dziennego progu wydatków generowanie się
# zatrzymuje dla całej aplikacji. Domyślnie 5 USD.
AI_DAILY_SPEND_CAP_USD=5

# ── Płatności (Stripe) ──────────────────────────────────────────────────────────
# UWAGA: klucze `sk_test_` i `sk_live_` to dwa rozłączne światy. Obiekty utworzone
# w jednym nie istnieją w drugim — nigdy nie mieszaj identyfikatorów między nimi.
#
# [WYMAGANE do płatności] Klucz tajny z panelu Stripe (Developers → API keys).
STRIPE_SECRET_KEY=sk_test_
# [WYMAGANE do płatności] Osobny sekret dla KAŻDEGO endpointu webhooka i każdego trybu.
# Lokalnie bierze się go z `stripe listen --forward-to localhost:3001/api/billing/webhook`.
# Produkcyjnie z panelu, po dodaniu endpointu https://czatsportowy.pl/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_
# [opcjonalne] Adres publiczny do zbudowania powrotów z płatności. Bez ukośnika na końcu.
# Puste = wartość APP_URL.
STRIPE_APP_PUBLIC_URL=https://czatsportowy.pl

# ── Poczta ──────────────────────────────────────────────────────────────────────
# [WYMAGANE] Konto wysyłkowe dla maili weryfikacyjnych i resetu hasła.
# EMAIL_PASS to hasło aplikacji, nie hasło do skrzynki.
EMAIL_USER=
EMAIL_PASS=

# ── Logowanie kontem Google ─────────────────────────────────────────────────────
# [opcjonalne] Bez tego zostaje logowanie hasłem. Obie zmienne mają TĘ SAMĄ wartość —
# wersja z NEXT_PUBLIC_ jest widoczna w przeglądarce (identyfikator klienta nie jest tajny).
# W konsoli Google dopisz produkcyjną domenę do „Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Zadanie rozliczające typy ───────────────────────────────────────────────────
# [opcjonalne] Domyślnie włączone o 4 rano czasu serwera. Na maszynie deweloperskiej
# warto ustawić SETTLE_PICKS_ENABLED=false.
SETTLE_PICKS_ENABLED=true
SETTLE_PICKS_HOUR=4
