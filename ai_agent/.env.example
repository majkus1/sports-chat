# Skopiuj do ai_agent/.env i uzupełnij wartościami.
# Plik .env jest w .gitignore — nie commituj go.

API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io

OPENAI_API_KEY=

SMTP_EMAIL=
SMTP_APP_PASSWORD=
